# =============================================================================
# THE SONDRAVO FAMILY — Official Family Registry
# Kopieer dit bestand naar .env.local en vul de waarden in.
# .env.local staat in .gitignore en hoort NOOIT in GitHub.
# =============================================================================

# -----------------------------------------------------------------------------
# VERPLICHT — Supabase
# Te vinden in: Supabase Dashboard > Project Settings > API
# -----------------------------------------------------------------------------

# De URL van je Supabase-project, bijv. https://abcdefgh.supabase.co
# Publiek: zit in de browserbundel. Dat mag — RLS bepaalt de rechten.
NEXT_PUBLIC_SUPABASE_URL=

# De "anon public" key. Ook publiek en ook veilig, zolang RLS aanstaat.
# Zonder deze twee waarden laadt de ledenlijst niet.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# OPTIONEEL — server-only geheimen
# Deze komen NOOIT in de browser terecht. Zet ze in Vercel als "Environment
# Variable" zonder NEXT_PUBLIC_ prefix.
# -----------------------------------------------------------------------------

# De "service_role" key. Omzeilt Row Level Security volledig.
# Alleen nodig voor het /new-commando van de Discord-bot (/api/bot/member).
# Deel deze key met niemand en zet hem nooit in client-side code.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# OPTIONEEL — Discord-sync
# Zonder deze twee werkt de site gewoon; er wordt dan de opgeslagen naam,
# de opgeslagen avatar of een initialen-fallback gebruikt.
# -----------------------------------------------------------------------------

# Bot token uit https://discord.com/developers/applications > Bot > Token.
# Server-only. Met dit token haalt de site displaynaam + avatar op en kan hij
# controleren of iemand nog in de server zit.
DISCORD_BOT_TOKEN=

# Het ID van de Sondravo Discord-server (rechtsklik op de server > ID kopiëren,
# met Developer Mode aan).
DISCORD_GUILD_ID=

# Rol-ID van de familierol: de rol die ieder lid van Sondravo draagt. De knop
# "Uit rollen halen" gebruikt deze rol om te bepalen wie op de ledenlijst hoort.
# De rang volgt uit de rangrol die iemand daarnaast heeft; die rollen worden op
# naam herkend (Mpitarika, Lefitra, ... Zazavao), dus daar hoef je hier niets
# voor in te vullen. Leeg = de rol-import staat uit.
DISCORD_MEMBER_ROLE_ID=

# Rol-ID dat toegang geeft tot het sollicitatieformulier. Wie deze rol niet
# draagt, krijgt het formulier niet te zien. Leeg = solliciteren staat uit.
DISCORD_APPLICANT_ROLE_ID=

# Discord-webhook waar een nieuwe sollicitatie gemeld wordt. Maak hem aan bij
# Kanaalinstellingen > Integraties > Webhooks. Leeg = geen melding in Discord;
# de sollicitatie komt dan alleen op de site binnen.
DISCORD_APPLICATION_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# OPTIONEEL — beheerrechten via een Discord-rol
# -----------------------------------------------------------------------------

# Rol-ID's die automatisch beheerrechten geven op de site. Wie in Discord deze
# rol heeft, kan na het inloggen de ledenlijst aanpassen. Raakt iemand de rol
# kwijt, dan verdwijnen die rechten bij zijn volgende login weer.
#
# Voor "Leader Sondravo Family" is dat dezelfde waarde als FOUNDER_ROLE_ID bij
# de bot: 1488178372721901807
# Meerdere rollen mogen, gescheiden door komma's.
#
# Werkt alleen samen met DISCORD_BOT_TOKEN en DISCORD_GUILD_ID hierboven.
# Handmatig toegevoegde admins blijven hoe dan ook werken.
DISCORD_ADMIN_ROLE_IDS=

# -----------------------------------------------------------------------------
# OPTIONEEL — koppeling met de Discord-bot (/new en /verwijder)
# -----------------------------------------------------------------------------

# Eén gedeeld geheim dat de bot meestuurt in de header x-sondravo-bot-secret.
# Genereer bijv. met: openssl rand -hex 32
# Zet exact dezelfde waarde in de environment van de bot.
# Laat leeg om het bot-endpoint uit te zetten.
BOT_API_SECRET=

# -----------------------------------------------------------------------------
# OPTIONEEL — presentatie
# -----------------------------------------------------------------------------

# De publieke URL van de site. Nodig voor correcte OAuth-redirects en
# deelkaarten. Op Vercel wordt dit automatisch afgeleid; lokaal mag het leeg.
NEXT_PUBLIC_SITE_URL=

# De intro-clip op de voorpagina. Mag een YouTube-link zijn of een bestand in
# /public (bijv. /media/sondravo.mp4). Leeg = onze eigen intro op YouTube.
NEXT_PUBLIC_HERO_VIDEO_URL=

# De intro draait in een lus: logo -> stukje clip -> logo -> ...
# Hoe lang het logo in beeld blijft, in seconden. Leeg = 3.5
NEXT_PUBLIC_HERO_LOGO_SECONDS=

# Hoe lang het fragment uit de clip speelt, in seconden. Leeg = 30
NEXT_PUBLIC_HERO_CLIP_SECONDS=

# Standaard speelt de intro het SLOT van de clip: er wordt teruggerekend vanaf
# het eind, zodat de lengte van de video nergens hard hoeft te staan. Zet hier
# 0 of false om in plaats daarvan vanaf NEXT_PUBLIC_HERO_CLIP_START te beginnen.
NEXT_PUBLIC_HERO_CLIP_FROM_END=

# Op welke seconde in de clip dat fragment begint. Leeg = 0 (het begin).
# Wil je bijvoorbeeld het stuk vanaf 0:12, zet hier 12. Wordt alleen gebruikt
# als NEXT_PUBLIC_HERO_CLIP_FROM_END uit staat.
NEXT_PUBLIC_HERO_CLIP_START=
